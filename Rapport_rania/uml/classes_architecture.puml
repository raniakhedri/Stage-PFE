@startuml diagramme_classes
!include style.iuml
hide circle
hide methods
skinparam linetype ortho
class Shop {
  name, slug : String
  businessType : String
  templateKey : String
  status : String
  logo : String
  theme : JSON
  settings : JSON
  customOptions : JSON
}
class User {
  email : String
  password : String
  firstName, lastName : String
  status : AccountStatus
  loyaltyPoints : int
  mustChangePassword : boolean
}
class Role {
  name : String
  shopId : Long
}
class Permission {
  module : PermissionModule
  granted : boolean
}
class AuthCode {
  email, purpose : String
  codeHash : String
  expiresAt : DateTime
  attempts : int
}
class MerchantVerification {
  documentType : String
  documentNumber : String
  selfie : String
  cardBrand, cardLast4 : String
  stripePaymentMethodId : String
  status : String
  rejectionReason : String
}
class Segment {
  name : String
  seuilPoints : int
  multiplicateurPoints : double
}
class Product {
  nom, slug : String
  salePrice : double
  stock : int
  tailles, couleur : String
  attributes : JSON
  statut : String
}
class ProductVariant {
  size, color : String\n stock : int
}
class Category {
  name, slug : String\n ordre : int
}
class Order {
  reference : String
  status : OrderStatus
  paymentMethod : String
  total : double
}
class OrderItem {
  quantity : int\n unitPrice : double\n size, color : String
}
class ReturnRequest {
  motif : String\n status : String
}
class Review {
  note : int\n commentaire : String
}
class Coupon {
  code, type : String\n valeur : double
}
class Discount {
  type : String\n valeur : double
}
class Banner {
  titre : String\n audience : String
}
class LoyaltyConfig {
  pointsParTnd : double
}
class PointsTransaction {
  points : int\n motif : String
}
class ShippingZone {
  nom : String\n tarif : double
}
class TvaRate {
  taux : double
}
class UserEvent <<analytics>> {
  visitorId, sessionId : String
  eventType : String
  productId : Long
  createdAt : Timestamp
}

Shop "1" -- "*" User : clients, équipe
Shop "1" -- "0..1" User : propriétaire
Shop "1" -- "0..1" MerchantVerification
Shop "1" -- "*" Role : rôles d'équipe
User "*" -- "1" Role
Role "1" *-- "*" Permission
User "*" -- "0..1" Segment
Shop "1" -- "*" Product
Product "*" -- "1" Category
Category "0..1" -- "*" Category : parent
Product "1" *-- "*" ProductVariant
User "1" -- "*" Order
Order "1" *-- "*" OrderItem
OrderItem "*" -- "1" Product
Order "1" -- "*" ReturnRequest
User "1" -- "*" Review
Review "*" -- "1" Product
Shop "1" -- "*" Coupon
Discount "*" -- "0..1" Product
Shop "1" -- "*" Banner
User "1" -- "*" PointsTransaction
Shop "1" -- "1" LoyaltyConfig
Shop "1" -- "*" ShippingZone
Shop "1" -- "*" TvaRate
Shop "1" -- "*" UserEvent
note right of User
  e-mail unique par boutique pour un client,
  unique sur Sellio pour un marchand,
  un membre d'équipe ou un administrateur
end note
@enduml

@startuml classes_analytics
!include style.iuml
skinparam linetype ortho
class TrackingController {
  +ingest(batch) : ResponseEntity
}
class TrackingService {
  +TYPES : Set<String>
  +record(batch)
  -rateLimit(visitorId)
}
class EventStore {
  +ensurePartitions()
  +insert(events)
  +dailyAggregates()
  +dropExpired()
}
class MlTrainingService {
  +nightly() <<@Scheduled 03:40>>
  +trainShop(shopId)
  -saveRecommendations()
  -saveSegments()
  -saveRun(metrics)
}
class PythonRunner {
  +run(task, input) : JSON
}
class RecommendationController {
  +similar()
  +forYou()
  +boughtTogether()
  +popular()
}
class RecommendationService {
  +similar(shop, product, limit)
  +forVisitor(shop, visitor, user, limit)
  +boughtTogether(shop, products, limit)
  +popular(shop, limit, exclude)
  -blendWithPopularity()
}
class BehaviorController {
  +overview()
  +train()
  +demoData()
}
class ShopAccess {
  +require(shop, user)
}
class ChurnController
class ChurnPredictionService {
  +modelFor(userId) : String
  +predictAll(features) : List<Double>
  +riskLabel(score, model) : String
}
class "ml_train.py\n(recommender, segmentation)" as PYT <<Python>>
class "predict.py\n(churn_model*.pkl)" as PYP <<Python>>

TrackingController --> TrackingService
TrackingService --> EventStore
MlTrainingService --> EventStore
MlTrainingService --> PythonRunner
PythonRunner ..> PYT
RecommendationController --> RecommendationService
BehaviorController --> ShopAccess
BehaviorController --> MlTrainingService
ChurnController --> ChurnPredictionService
ChurnPredictionService ..> PYP
@enduml

@startuml architecture_logique
!include style.iuml
skinparam componentStyle rectangle
package "Couche présentation" {
  [Application Sellio :3000\n(site plateforme, console,\nback-office, éditeurs)] as FE1
  [Vitrine :3001\n(8 modèles, 8 secteurs)] as FE2
}
package "Couche passerelle" {
  [Spring Cloud Gateway :8080] as GW
}
package "Couche métier (microservices Spring Boot)" {
  [auth-service :8081\ncomptes, JWT, rôles, boutiques,\npersonnalisation, KYC, fidélité] as AS
  [catalog-service :8082\nproduits par secteur,\ncatégories, avis, essayage] as CS
  [order-service :8083\ncommandes, Stripe, retours,\nTVA, promotions] as OS
  [marketing-service :8084\nbannières, e-mailing] as MS
  [analytics-service :8085\nsuivi, recommandations,\nsegments, attrition] as AN
}
package "Couche intelligence" {
  [Scripts Python\npandas, scikit-learn] as PY
}
package "Couche données (PostgreSQL)" {
  database "sellio_auth" as DA
  database "sellio_catalog" as DC2
  database "sellio_orders" as DO
  database "sellio_marketing" as DM
  database "sellio_analytics" as DN
}
cloud "Services externes" {
  [Stripe] as ST
  [Decart] as DC
  [Brevo] as BR
}
FE1 --> GW : REST / JSON
FE2 --> GW : REST / JSON
FE1 ..> FE2 : aperçu en direct\n(iframe + postMessage)
GW --> AS
GW --> CS
GW --> OS
GW --> MS
GW --> AN
OS ..> CS : /internal (stock)
OS ..> AS : /internal (points)
AN ..> CS : /internal (produits)
AN ..> OS : /internal (commandes)
AN --> PY : sous-processus
AS --> DA
CS --> DC2
OS --> DO
MS --> DM
AN --> DN
OS --> ST
CS --> DC
AS --> BR
OS --> BR
MS --> BR
FE2 ..> ST : Stripe.js
FE2 ..> DC : WebRTC
@enduml

@startuml architecture_physique
!include style.iuml
node "Poste client" {
  node "Navigateur web" {
    [Application Sellio / Vitrine\n(React)] as B
  }
}
node "Hôte Docker (docker compose)" {
  node "conteneur storefront\nnginx :3001" as SF
  node "conteneur backoffice\nnginx :3000" as BO
  node "conteneur api-gateway :8080" as GW
  node "auth-service :8081" as A
  node "catalog-service :8082" as C
  node "order-service :8083" as O
  node "marketing-service :8084" as M
  node "analytics-service :8085\nJava 17 + Python 3.12" as AN
  node "postgres-auth :5432" as PGA {
    database "sellio_auth" as DBA
  }
  node "postgres-catalog :5433" as PGC {
    database "sellio_catalog" as DBC
  }
  node "postgres-orders :5434" as PGO {
    database "sellio_orders" as DBO
  }
  node "postgres-marketing :5435" as PGM {
    database "sellio_marketing" as DBM
  }
  node "postgres-analytics :5436" as PGN {
    database "sellio_analytics" as DBN
  }
  storage "volume auth" as VA
  storage "volume catalog" as VC
  storage "volume orders" as VO
  storage "volume marketing" as VM
  storage "volume analytics" as VN
  storage "volume uploads" as V2
}
cloud "Stripe" as ST
cloud "Decart" as DC
cloud "Brevo" as BR
B --> SF : HTTPS
B --> BO : HTTPS
B --> GW : HTTPS / REST
B --> ST : HTTPS (Stripe.js)
B --> DC : WebRTC (UDP)
GW --> A
GW --> C
GW --> O
GW --> M
GW --> AN
A --> DBA : JDBC
C --> DBC : JDBC
O --> DBO : JDBC
M --> DBM : JDBC
AN --> DBN : JDBC
O ..> C : API interne
AN ..> O : API interne
PGA ..> VA
PGC ..> VC
PGO ..> VO
PGM ..> VM
PGN ..> VN
C ..> V2
O --> ST : HTTPS
C --> DC : HTTPS (jeton)
A --> BR : HTTPS
M --> BR : HTTPS
@enduml

@startuml architecture_tryon
!include style.iuml
left to right direction
node "Navigateur du client" {
  [Caméra\n1280×720] as CAM
  [TryOnModal\n(React)] as UI
  [SDK Decart] as SDK
}
node "Sellio" {
  [API Gateway] as GW
  [catalog-service\nDecartTryOnService] as CS
  [Clé secrète Decart\n(variable d'environnement)] as KEY
}
cloud "Decart" {
  [POST /v1/client/tokens] as TOK
  [Modèle temps réel\nlucy-vton-latest] as MOD
}
UI --> GW : 1. demander un jeton
GW --> CS
CS ..> KEY
CS --> TOK : 2. jeton éphémère (600 s)
CAM --> UI : 3. flux caméra
UI --> SDK : 4. flux + consigne + image du vêtement
SDK --> MOD : WebRTC
MOD --> SDK : 5. vidéo générée
SDK --> UI : affichage (45 s)
@enduml

@startuml architecture_ml
!include style.iuml
left to right direction
node "Vitrine" {
  [tracker.js] as TR
  [RecommendedProducts] as RP
}
node "Back-office" {
  [Comportement.jsx\nClients.jsx] as BO
}
node "catalog-service" {
  [API interne\n/internal/products] as CI
}
node "order-service" {
  [API interne\n/internal/orders] as OI
}
node "analytics-service" {
  [TrackingController\nTrackingService] as TC
  [EventStore] as ES
  [MlTrainingService\n(chaque nuit 3 h 40)] as MT
  [PythonRunner] as PR
  [RecommendationService] as RS
  [BehaviorController\nChurnPredictionService] as BC
}
node "Python" {
  [ml_train.py\nhybride SVD + TF-IDF,\nrègles d'association, K-Means] as PT
  [predict.py\nforêt aléatoire /\ngradient boosting] as PP
}
database "sellio_analytics" {
  [user_events\n(partitions mensuelles, BRIN)] as UE
  [product_recommendations\nbehavior_segments\nml_model_runs] as RT
}
TR --> TC : lots d'événements
TC --> ES
ES --> UE
MT --> UE : événements
MT --> CI : produits
MT --> OI : commandes payées
MT --> PR
PR --> PT
MT --> RT : résultats
RS --> RT : lecture indexée
RP --> RS
BO --> BC
BC --> PP
BC --> RT
@enduml

@startuml pipeline_ci
!include style.iuml
skinparam ActivityBackgroundColor #eef2fb
skinparam ActivityBorderColor #1f2a44
skinparam ActivityDiamondBackgroundColor #ffffff
start
:Push ou pull request sur GitHub;
:GitHub Actions démarre le workflow CI;
fork
  :Backend\nmvn verify (Java 17)\n7 modules + tests JUnit;
fork again
  :Frontend\nnpm ci, tests Vitest,\nbuild vitrine et back-office;
fork again
  :Machine learning\npip install, tests pytest\n(recommandation, segmentation, churn);
end fork
if (Tous les tests passent ?) then (oui)
  :Construction des 8 images Docker\n(6 services + 2 front-ends, cache BuildKit);
  if (Push sur main ?) then (oui)
    :Publication sur GitHub Container Registry\nghcr.io/<compte>/sellio-<service>;
  else (pull request)
    :Images construites, non publiées;
  endif
  :Pipeline vert;
else (non)
  :Pipeline rouge\nrapports JUnit en artefact;
  stop
endif
stop
@enduml

@startuml architecture_devops
!include style.iuml
left to right direction
actor "Développeuse" as DEV
node "Poste de développement" {
  [Code source\n(microservices, Frontend, ML)] as SRC
}
cloud "GitHub" {
  [Dépôt Stage-PFE] as REPO
  [GitHub Actions\nworkflow CI] as GA
  [Dependabot] as DB
  [GitHub Container\nRegistry (ghcr.io)] as REG
}
node "Serveur / poste\navec Docker" {
  [docker compose up] as DC
  [8 conteneurs Sellio\n+ 5 PostgreSQL] as RUN
}
DEV --> SRC
SRC --> REPO : git push / pull request
DB --> REPO : PR de mise à jour
REPO --> GA : déclenche
GA --> REG : images (main)
REG --> DC : docker pull
DC --> RUN
@enduml
