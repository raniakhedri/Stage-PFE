# Copy to .env (same folder) and fill in. .env is git-ignored.
# Every service reads this file at startup (spring.config.import); Docker Compose reads it too.

# ── Database (PostgreSQL) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=naturessence
DB_USERNAME=postgres
DB_PASSWORD=admin

# ── JWT: same secret for every service, at least 64 characters ──
JWT_SECRET=
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ── Public addresses (links in e-mails, CORS) ────────────────
APP_BACKOFFICE_URL=http://localhost:3000
APP_STOREFRONT_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Payments: Stripe test keys (https://dashboard.stripe.com/test/apikeys) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── E-mail (Brevo): https://app.brevo.com/settings/keys/api — the sender must be verified in Brevo.
# While BREVO_API_KEY is empty, e-mails are not sent: their content (codes, passwords) is printed in the log.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Sellio
BREVO_REPLY_TO=

# ── Virtual try-on (Decart) ──────────────────────────────────
DECART_API_KEY=

# ── Analytics: Python used for the ML scripts ────────────────
CHURN_PYTHON=python
