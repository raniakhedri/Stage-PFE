@startuml dso_login
!include style.iuml
autonumber
actor "Utilisateur" as U
boundary "Login.jsx" as UI
participant "API Gateway" as GW
control "AuthController" as C
control "AuthService" as SV
entity "UserRepository" as UR
participant "JwtUtil" as J
control "RefreshTokenService" as RT
U -> UI : e-mail, mot de passe
UI -> GW : POST /api/v1/auth/login\n{email, password, shopSlug?}
GW -> C : route vers auth-service
C -> SV : login(request)
alt shopSlug présent (vitrine)
  SV -> UR : findClientByEmail(e-mail, boutique)
else espace Sellio
  SV -> UR : findAccountByEmail(e-mail)
end
UR --> SV : User ou vide
SV -> SV : BCrypt.matches()
alt introuvable ou mot de passe faux
  SV --> C : 401 « Email ou mot de passe incorrect »
else authentifié
  SV -> SV : status BLOCKED / INACTIVE ?
  alt bloqué
    SV --> C : LockedException (401)
  else actif
    SV -> J : generateAccessToken(user, slug)
    J --> SV : jeton (userId, rôle, boutique, permissions)
    SV -> RT : createRefreshToken(user)
    RT --> SV : jeton de rafraîchissement
    SV --> C : AuthResponse
  end
end
C --> GW : réponse
GW --> UI : réponse
UI -> UI : stocker les jetons (clé propre à la boutique),\nrediriger
@enduml

@startuml dso_kyc
!include style.iuml
autonumber
actor "Commerçant" as M
boundary "NouvelleBoutique.jsx\n(CardStep, IdentityStep)" as UI
participant "Stripe.js" as SJ
control "StripeController\n(order-service)" as STC
control "AuthController" as C
control "AuthService" as SV
control "MerchantVerificationService" as MV
entity "ShopRepository" as SR
entity "MerchantVerificationRepository" as VR
actor "Administrateur" as A
boundary "VerificationBoutique /\nSellioConsole" as AUI
control "PlatformController" as PC
M -> UI : informations, secteur, identité visuelle
UI -> STC : POST /public/stripe/setup-intent
STC --> UI : client secret
UI -> SJ : confirmCardSetup(carte)
SJ --> UI : pm_…, marque, 4 derniers chiffres, expiration
M -> UI : pièce d'identité + selfie
UI -> C : POST /auth/my-shop (boutique + dossier)
C -> SV : createShop(e-mail, request)
SV -> MV : requireComplete(dossier)
alt dossier invalide
  MV --> C : IllegalArgumentException (400)
else dossier valide
  SV -> SR : save(shop, status = PENDING)
  SV -> MV : submit(userId, shopId, dossier)
  MV -> VR : save(verification, PENDING)
  C --> UI : boutique en attente
end
A -> AUI : ouvrir le dossier
AUI -> PC : GET /admin/platform/verifications/{id}
PC -> MV : detail(id)
MV --> AUI : pièces, selfie, carte
alt validation
  AUI -> PC : POST …/{id}/approve
  PC -> MV : approve(id, reviewer)
  MV -> SR : shop.status = ACTIVE
else refus
  AUI -> PC : POST …/{id}/reject (motif)
  PC -> MV : reject(id, motif, reviewer)
  MV -> SR : shop.status = REJECTED
end
@enduml

@startuml dso_produit
!include style.iuml
autonumber
actor "Commerçant" as M
boundary "AjouterProduit.jsx\n(OptionPickers)" as UI
participant "useShopOptions" as OPT
control "FileUploadController" as FU
control "AdminProductController" as C
control "ProductService" as SV
entity "ProductRepository" as PR
entity "ProductVariantRepository" as VR
M -> UI : ouvrir le formulaire
UI -> SEC : GET /auth/my-shop
SEC --> UI : secteur de la boutique
M -> UI : type de produit
UI -> UI : sizesOf(secteur, type)\nfieldsOf(secteur, type)
UI -> OPT : options (défaut + boutique)
OPT --> UI : tailles, couleurs, tissus
M -> UI : images
UI -> FU : POST /admin/upload
FU --> UI : URL
M -> UI : informations, attributs, stock
opt nouvelle valeur
  UI -> OPT : ajouter (customOptions de la boutique)
end
UI -> C : POST /admin/products
C -> SV : createProduct(request)
SV -> SV : valider (cleanAttributes)
SV -> PR : save(product)
SV -> VR : saveAll(variantes)
SV --> C : ProductResponse
C --> UI : 201 produit créé
@enduml

@startuml dso_theme
!include style.iuml
autonumber
actor "Commerçant" as M
boundary "PageAccueil.jsx" as UI
boundary "StorefrontPreview\n(iframe)" as PV
boundary "Vitrine\n(StoreContext, HomeSections)" as ST
participant "API Gateway" as GW
control "AuthController" as C
control "AuthService" as SV
participant "ShopSettingsValidator" as VAL
entity "ShopRepository" as SR
M -> UI : ouvrir Page d'accueil
UI -> GW : GET /auth/my-shop
GW --> UI : boutique (modèle, secteur, settings)
UI -> PV : charger /{slug}/?preview=modèle
PV -> ST : vitrine dans l'iframe
ST --> UI : postMessage « sellio:preview-ready »
loop chaque modification
  M -> UI : masquer / réordonner / écrire
  UI -> ST : postMessage « sellio:preview »\n{settings non enregistrés}
  ST -> ST : sectionOrder() + applyTexts()\nnouveau rendu
end
M -> UI : Enregistrer
UI -> GW : PATCH /auth/my-shop {settings}
GW -> C : route vers auth-service
C -> SV : updateShop(userId, request)
SV -> VAL : clean(settings)
alt JSON invalide ou lien non https
  VAL --> SV : IllegalArgumentException
  SV --> UI : 400 + message
else valide
  VAL --> SV : JSON normalisé
  SV -> SR : save(shop)
  SV --> UI : boutique mise à jour
end
@enduml

@startuml dso_commande
!include style.iuml
autonumber
actor "Client" as CL
boundary "CheckoutPage.jsx" as UI
participant "Stripe.js" as SJ
control "StripeController" as STC
participant "StripeService" as SS
control "PublicCheckoutController" as C
control "OrderService" as SV
control "CouponService" as CS
participant "CatalogClient" as CAT
entity "OrderRepository\n(sellio_orders)" as OR
participant "EmailService" as ES
CL -> UI : adresse, code promo
UI -> CS : GET /public/coupons/validate
CS --> UI : remise
CL -> UI : payer par carte
UI -> STC : POST /public/stripe/payment-intent
STC -> CAT : prix actuels des articles
STC -> SS : createPaymentIntent(total, réf.)
SS --> UI : client secret
UI -> SJ : confirmPayment(carte)
SJ --> UI : succès
UI -> C : POST /public/checkout/orders
C -> SV : createOrder(request)
SV -> CAT : POST /internal/stock/reserve\n(catalog-service)
alt stock insuffisant
  CAT --> SV : 409
  SV --> C : 400 « Quantité indisponible »
else stock réservé
  CAT --> SV : noms et prix des articles
  SV -> SV : TVA, livraison, sous-total
  SV -> CS : appliquer le coupon et\nenregistrer l'utilisation
  SV -> OR : save(order) avec copie\ndes articles et du client
  SV -> ES : sendOrderConfirmation(order)
  SV --> C : OrderResponse
end
C --> UI : commande créée
UI -> UI : vider le panier, suivre PURCHASE
@enduml

@startuml dso_retour
!include style.iuml
autonumber
actor "Client" as CL
boundary "MesCommandes / MesRetours" as UI
control "ProfileOrderController" as PC
control "ReturnService" as RS
entity "OrderRepository" as OR
entity "ReturnRequestRepository" as RR
actor "Commerçant" as M
boundary "Retours.jsx / DetailRetour.jsx" as AUI
control "AdminReturnController" as AC
CL -> UI : articles, motif
UI -> PC : POST /profile/returns
PC -> RS : createReturn(e-mail, dto)
RS -> OR : findById(commande)
RS -> RS : livrée + délai de la politique ?
alt hors délai
  RS --> PC : 400
else
  RS -> RR : save(demande, en attente)
  PC --> UI : demande créée
end
M -> AUI : consulter
AUI -> AC : GET /admin/returns
AC --> AUI : demandes
M -> AUI : accepter / rembourser / refuser
AUI -> AC : PATCH /admin/returns/{id}/status
AC -> RS : updateStatus(id, statut, motif)
RS -> RR : save
@enduml

@startuml dso_coupon
!include style.iuml
autonumber
actor "Commerçant" as M
boundary "Promotions.jsx" as UI
control "AdminPromotionController" as C
control "CouponService" as SV
entity "CouponRepository" as CR
M -> UI : paramètres du code
UI -> C : POST /admin/promotions/coupons
C -> SV : create(request)
SV -> CR : existsByCode(code)
alt existe
  SV --> C : 400 « existe déjà »
else
  SV -> SV : computeStatut(dates)
  SV -> CR : save(coupon)
  C --> UI : 201
end
@enduml

@startuml dso_fidelite
