@startuml dso_comportement
!include style.iuml
autonumber
actor "Commerçant" as M
boundary "Comportement.jsx" as UI
control "BehaviorController" as BC
participant "ShopAccess" as SA
database "PostgreSQL" as DB
boundary "Clients.jsx" as CUI
control "ChurnController" as CC
control "ChurnPredictionService" as CP
participant "predict.py\n(modèle du secteur)" as PY
M -> UI : ouvrir
UI -> BC : GET /analytics/behavior/overview?shop=
BC -> SA : vérifier shop.id == user.shopId
alt refusé
  SA --> UI : 403
else
  BC -> DB : entonnoir, segments, runs
  BC --> UI : synthèse
end
M -> CUI : liste des clients
CUI -> CC : POST /analytics/churn/batch-ids
CC -> CP : predictAll(features)
CP -> CP : modelFor(client) (general / clothes)
CP -> PY : sous-processus
PY --> CP : probabilités
CP -> CP : riskLabel(score, modèle)
CC --> CUI : HIGH / MEDIUM / LOW
@enduml

@startuml dso_suppression
!include style.iuml
autonumber
actor "Administrateur Sellio" as A
boundary "SellioConsole.jsx\n(DeleteAccountDialog)" as UI
participant "API Gateway" as GW
control "PlatformController\n(auth-service)" as C
control "PlatformAccountService" as SV
participant "analytics-service" as AN
participant "marketing-service" as MK
participant "order-service" as OS
participant "catalog-service" as CS
database "sellio_auth" as DB
A -> UI : taper le nom de la boutique, confirmer
UI -> GW : DELETE /admin/platform/users/{id}
GW -> C : jeton SELLIO_ADMIN
C -> SV : deleteAccount(appelant, id)
SV -> DB : marchand et boutique
SV -> AN : DELETE /internal/shops/{shopId}
AN --> SV : 204 (événements, recommandations, segments)
SV -> MK : DELETE /internal/shops/{shopId}
MK --> SV : 204 (bannières)
SV -> OS : DELETE /internal/shops/{shopId}
OS --> SV : 204 (commandes, retours, promotions)
SV -> CS : DELETE /internal/shops/{shopId}
CS --> SV : 204 (produits, catégories, avis)
alt un service indisponible
  SV --> C : 503, rien n'est supprimé dans sellio_auth\n(l'opération peut être relancée)
else toutes les bases nettoyées
  SV -> DB : clients, équipe, rôles,\nboutique, marchand
  SV --> C : {boutique, nombre de clients}
end
C --> UI : 200
UI --> A : « Marchand supprimé avec sa boutique »
@enduml
