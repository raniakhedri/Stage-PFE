{
  "name": "naturessence-frontend",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Sellio — storefront (src/) and backoffice (backoffice/) of the multi-shop platform",
  "workspaces": [
    "backoffice",
    "frontoffice"
  ],
  "scripts": {
    "dev:backoffice": "npm run dev --workspace=backoffice",
    "dev:frontoffice": "npm run dev --workspace=frontoffice",
    "dev": "npm run dev:backoffice & npm run dev:frontoffice",
    "build:backoffice": "npm run build --workspace=backoffice",
    "build:frontoffice": "npm run build --workspace=frontoffice",
    "build": "npm run build:backoffice && npm run build:frontoffice",
    "lint": "npm run lint --workspace=backoffice",
    "test": "vitest run && npm run test --workspace=backoffice"
  },
  "dependencies": {
    "@decartai/sdk": "^0.2.3",
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "jsdom": "^25.0.0",
    "vitest": "^3.2.7"
  }
}
