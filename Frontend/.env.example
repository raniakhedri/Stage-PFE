# ══════════════════════════════════════════════════════════════
# Frontend Environment Variables
# Copy this file to .env in each sub-project
# Variables must start with VITE_ to be exposed to the app
# ══════════════════════════════════════════════════════════════

VITE_API_BASE_URL=http://localhost:8080/api/v1

# Permanent Decart key for the Vite token proxy (dev only). Never prefix with VITE_.
DECART_API_KEY=
