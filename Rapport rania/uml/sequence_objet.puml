@startuml dso_commande
!include style.iuml
autonumber
actor "Client" as CL
boundary "CheckoutPage.jsx" as UI
participant "Stripe.js" as SJ
control "PublicCouponController" as CC
control "StripeController" as STC
participant "StripeService" as SS
control "PublicCheckoutController" as C
control "OrderService" as SV
control "CouponService" as CS
entity "OrderRepository" as OR
entity "ProductRepository" as PR
participant "EmailService" as ES
CL -> UI : adresse, code promo
UI -> CC : GET /public/coupons/validate
CC --> UI : remise
CL -> UI : payer par carte
UI -> STC : POST /public/stripe/payment-intent
STC -> SS : createPaymentIntent(total, réf.)
SS --> UI : client secret
UI -> SJ : confirmPayment(carte)
SJ --> UI : succès
UI -> C : POST /public/checkout/orders
C -> SV : createOrder(request)
SV -> SV : TVA, livraison, sous-total
SV -> CS : appliquer le coupon et\nenregistrer l'utilisation
SV -> OR : save(order)
SV -> PR : décrémenter le stock
SV -> ES : sendOrderConfirmation(order)
SV --> C : OrderResponse
C --> UI : commande créée
UI -> UI : vider le panier, suivre PURCHASE
@enduml

@startuml dso_retour
!include style.iuml
autonumber
actor "Client" as CL
boundary "MesCommandes / MesRetours" as UI
control "ProfileOrderController" as PC
control "ReturnService" as RS
entity "OrderRepository" as OR
entity "ReturnRequestRepository" as RR
actor "Commerçant" as M
boundary "Retours.jsx / DetailRetour.jsx" as AUI
control "AdminReturnController" as AC
CL -> UI : articles, motif
UI -> PC : POST /profile/returns
PC -> RS : createReturn(e-mail, dto)
RS -> OR : findById(commande)
RS -> RS : livrée + délai de la politique ?
alt hors délai
  RS --> PC : 400
else
  RS -> RR : save(demande, en attente)
  PC --> UI : demande créée
end
M -> AUI : consulter
AUI -> AC : GET /admin/returns
AC --> AUI : demandes
M -> AUI : accepter / rembourser / refuser
AUI -> AC : PATCH /admin/returns/{id}/status
AC -> RS : updateStatus(id, statut, motif)
RS -> RR : save
@enduml

@startuml dso_coupon
!include style.iuml
autonumber
actor "Commerçant" as M
boundary "Promotions.jsx" as UI
control "AdminPromotionController" as C
control "CouponService" as SV
entity "CouponRepository" as CR
M -> UI : paramètres du code
UI -> C : POST /admin/promotions/coupons
C -> SV : create(request)
SV -> CR : existsByCode(code)
alt existe
  SV --> C : 400 « existe déjà »
else
  SV -> SV : computeStatut(dates)
  SV -> CR : save(coupon)
  C --> UI : 201
end
@enduml

