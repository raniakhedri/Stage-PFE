@startuml dso_login
!include style.iuml
autonumber
actor "Utilisateur" as U
boundary "Login.jsx" as UI
participant "API Gateway" as GW
control "AuthController" as C
control "AuthService" as SV
participant "AuthenticationManager" as AM
entity "UserRepository" as UR
participant "JwtUtil" as J
control "RefreshTokenService" as RT
U -> UI : e-mail, mot de passe
UI -> GW : POST /api/v1/auth/login
GW -> C : route vers auth-service
C -> SV : login(request)
SV -> AM : authenticate(e-mail, mot de passe)
AM -> UR : findByEmail(e-mail)
UR --> AM : User
AM -> AM : BCrypt.matches()
alt identifiants invalides
  AM --> SV : BadCredentialsException
  SV --> C : 401 « Email ou mot de passe incorrect »
else authentifié
  SV -> SV : status == BLOCKED ?
  alt bloqué
    SV --> C : LockedException (401)
  else actif
    SV -> J : generateAccessToken(user)
    J --> SV : jeton d'accès
    SV -> RT : createRefreshToken(user)
    RT --> SV : jeton de rafraîchissement
    SV --> C : AuthResponse
  end
end
C --> GW : réponse
GW --> UI : réponse
UI -> UI : stocker les jetons, rediriger
@enduml

@startuml dso_kyc
!include style.iuml
autonumber
actor "Commerçant" as M
boundary "NouvelleBoutique.jsx\n(CardStep, IdentityStep)" as UI
participant "Stripe.js" as SJ
control "StripeController\n(order-service)" as STC
control "AuthController" as C
control "AuthService" as SV
control "MerchantVerificationService" as MV
entity "ShopRepository" as SR
entity "MerchantVerificationRepository" as VR
actor "Administrateur" as A
boundary "VerificationBoutique /\nSellioConsole" as AUI
control "PlatformController" as PC
M -> UI : informations, secteur, identité visuelle
UI -> STC : POST /public/stripe/setup-intent
STC --> UI : client secret
UI -> SJ : confirmCardSetup(carte)
SJ --> UI : pm_…, marque, 4 derniers chiffres, expiration
M -> UI : pièce d'identité + selfie
UI -> C : POST /auth/my-shop (boutique + dossier)
C -> SV : createShop(e-mail, request)
SV -> MV : requireComplete(dossier)
alt dossier invalide
  MV --> C : IllegalArgumentException (400)
else dossier valide
  SV -> SR : save(shop, status = PENDING)
  SV -> MV : submit(userId, shopId, dossier)
  MV -> VR : save(verification, PENDING)
  C --> UI : boutique en attente
end
A -> AUI : ouvrir le dossier
AUI -> PC : GET /admin/platform/verifications/{id}
PC -> MV : detail(id)
MV --> AUI : pièces, selfie, carte
alt validation
  AUI -> PC : POST …/{id}/approve
  PC -> MV : approve(id, reviewer)
  MV -> SR : shop.status = ACTIVE
else refus
  AUI -> PC : POST …/{id}/reject (motif)
  PC -> MV : reject(id, motif, reviewer)
  MV -> SR : shop.status = REJECTED
end
@enduml

@startuml dso_produit
!include style.iuml
autonumber
actor "Commerçant" as M
boundary "AjouterProduit.jsx\n(OptionPickers)" as UI
participant "useShopOptions" as OPT
control "FileUploadController" as FU
control "AdminProductController" as C
control "ProductService" as SV
entity "ProductRepository" as PR
entity "ProductVariantRepository" as VR
M -> UI : ouvrir le formulaire
UI -> OPT : options (défaut + boutique)
OPT --> UI : tailles, couleurs, tissus
M -> UI : images
UI -> FU : POST /admin/upload
FU --> UI : URL
M -> UI : informations, attributs, stock
opt nouvelle valeur
  UI -> OPT : ajouter (customOptions de la boutique)
end
UI -> C : POST /admin/products
C -> SV : createProduct(request)
SV -> SV : valider
SV -> PR : save(product)
SV -> VR : saveAll(variantes)
SV --> C : ProductResponse
C --> UI : 201 produit créé
@enduml

