@startuml dso_tryon
!include style.iuml
autonumber
actor "Visiteur" as V
boundary "TryOnModal.jsx" as UI
participant "apiClient\ncreateTryOnToken()" as API
control "PublicTryOnController" as C
control "DecartTryOnService" as SV
participant "API Decart\n/v1/client/tokens" as DT
participant "SDK Decart\n(client.realtime)" as SDK
participant "Modèle\nlucy-vton-latest" as MOD
V -> UI : « Essayer virtuellement »
UI -> API : createTryOnToken()
API -> C : POST /public/tryon/token
C -> SV : createClientToken()
SV -> DT : POST (x-api-key, expiresIn 600)
DT --> SV : apiKey éphémère, expiresAt
SV --> API : jeton + sessionSeconds
API --> UI : jeton
UI -> UI : getUserMedia(1280×720)
UI -> UI : fetchGarmentBlob() (768 px, JPEG)
UI -> SDK : connect(stream, model)
SDK -> MOD : session WebRTC
UI -> SDK : set({prompt, image})
MOD --> SDK : flux vidéo généré
SDK --> UI : onRemoteStream
UI -> UI : compte à rebours 45 s
UI -> SDK : disconnect()
@enduml

@startuml dso_reco
!include style.iuml
autonumber
actor "Visiteur" as V
boundary "RecommendedProducts.jsx" as UI
participant "tracker.js" as TR
control "TrackingController" as TC
participant "EventStore" as ES
control "RecommendationController" as C
control "RecommendationService" as SV
database "PostgreSQL\n(user_events,\nproduct_recommendations)" as DB
control "PublicProductController" as PP
V -> TR : consulter des produits
TR -> TC : POST /analytics/events (lot)
TC -> ES : insert
ES -> DB : INSERT user_events
UI -> C : GET /analytics/recommendations/for-you
C -> SV : forVisitor(shop, visiteur, client)
SV -> DB : historique récent pondéré
alt historique vide
  SV -> DB : produits populaires
else
  SV -> DB : voisins SIMILAR
  SV -> SV : somme pondérée + α·popularité,\nexclure panier/achats
end
SV --> UI : identifiants + stratégie
UI -> PP : GET /public/products/by-ids
PP --> UI : fiches produit
UI --> V : section « Pour vous »
@enduml

@startuml dso_comportement
!include style.iuml
autonumber
actor "Commerçant" as M
boundary "Comportement.jsx" as UI
control "BehaviorController" as BC
participant "ShopAccess" as SA
database "PostgreSQL" as DB
boundary "Clients.jsx" as CUI
control "ChurnController" as CC
control "ChurnPredictionService" as CP
participant "predict.py\n(modèle du secteur)" as PY
M -> UI : ouvrir
UI -> BC : GET /analytics/behavior/overview?shop=
BC -> SA : vérifier shop.id == user.shopId
alt refusé
  SA --> UI : 403
else
  BC -> DB : entonnoir, segments, runs
  BC --> UI : synthèse
end
M -> CUI : liste des clients
CUI -> CC : POST /analytics/churn/batch-ids
CC -> CP : predictAll(features)
CP -> CP : modelFor(client) (general / clothes)
CP -> PY : sous-processus
PY --> CP : probabilités
CP -> CP : riskLabel(score, modèle)
CC --> CUI : HIGH / MEDIUM / LOW
@enduml
