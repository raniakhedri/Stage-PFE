# ══════════════════════════════════════════════════════════════
# Backend Environment Variables
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=naturessence
DB_USERNAME=postgres
DB_PASSWORD=admin

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=Gm1rJ3w3lryS3cr3tK3yTh4tIsL0ngEn0ughF0rHS512Alg0r1thmR3qu1r3m3nts2026
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Brevo (Email) ─────────────────────────────────────────────
# Get your API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your-sender@email.com
BREVO_SENDER_NAME=NaturEssence
BREVO_REPLY_TO=your-sender@email.com
