# ── IDE / OS ─────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Secrets (NEVER commit them: copy microservices/.env.example) ──
.env
.env.local
.env.*.local

# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Build output ─────────────────────────────────────────────
target/
dist/
__pycache__/
*.pyc

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Windows reserved names created by mistaken redirections ──
nul

# ── Raw ML datasets (downloaded; rebuilt by python/data_prep/*) ──
microservices/analytics-service/python/datasets/raw/

